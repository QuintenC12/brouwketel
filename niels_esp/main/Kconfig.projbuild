menu "Niels ESP: wifi en ketel"

    config NIELS_WIFI_NAAM
        string "Wifi-naam (SSID)"
        default "mijn-wifi"

    config NIELS_WIFI_WACHTWOORD
        string "Wifi-wachtwoord"
        default "mijn-wachtwoord"

    config NIELS_PIN_SSR
        int "SSR (verwarming)"
        range 0 48
        default 5

    config NIELS_PIN_POMP
        int "Pomp"
        range 0 48
        default 6

    config NIELS_PIN_ZOEMER
        int "Zoemer"
        range 0 48
        default 7

endmenu
